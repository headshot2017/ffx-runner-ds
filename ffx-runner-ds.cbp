					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q -f $makefile BLOCKSDS=$(BLOCKSDS) BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN) VERBOSE=1" />
					<SilentBuild command="$make -f $makefile BLOCKSDS=$(BLOCKSDS)  BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN) VERBOSE=1 &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
			<Target title="Copy of Default">
				<Option output="bin/Release/ffx-runner-ds" prefix_auto="1" extension_auto="1" />
