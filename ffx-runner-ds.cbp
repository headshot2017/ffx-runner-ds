<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ffx-runner-ds" />
		<Option makefile_is_custom="1" />
		<Option pch_mode="2" />
		<Option compiler="blocksds" />
		<MakeCommands>
			<Build command="$make -f $makefile BLOCKSDS=$(BLOCKSDS)  BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN)" />
			<CompileFile command="$make -f $makefile $file BLOCKSDS=$(BLOCKSDS) BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN)" />
			<Clean command="$make -f $makefile clean BLOCKSDS=$(BLOCKSDS) BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN)" />
			<DistClean command="$make -f $makefile distclean$target" />
			<AskRebuildNeeded command="$make -q -f $makefile BLOCKSDS=$(BLOCKSDS) BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN)" />
			<SilentBuild command="$make -f $makefile BLOCKSDS=$(BLOCKSDS)  BLOCKSDSEXT=$(BLOCKSDSEXT) WONDERFUL_TOOLCHAIN=$(WONDERFUL_TOOLCHAIN) &gt; $(CMD_NULL)" />
		</MakeCommands>
		<Build>
			<Target title="Default">
				<Option output="bin/Release/ffx-runner-ds" prefix_auto="1" extension_auto="1" />
